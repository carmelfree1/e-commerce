# Copiez ce fichier en .env puis adaptez-le.
# Base PostgreSQL (la base est créée automatiquement si l'utilisateur a le droit CREATEDB)
DATABASE_URL=postgres://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/ccm_nonsaka

PORT=3000
# NODE_ENV=production        # active les cookies "secure" (HTTPS obligatoire)

# Compte admin créé au premier lancement (sinon un mot de passe aléatoire s'affiche dans la console)
# ADMIN_EMAIL=admin@ccm-nonsaka.com
# ADMIN_PASSWORD=

# SEED_DEMO=0                # ne pas créer les produits d'exemple
# SESSION_SECRET=            # facultatif : sinon généré et conservé en base

# --- Sécurité ---
# Nombre de proxys de confiance devant l'app (nginx, Render, Railway…). Par défaut : 1 en production, 0 sinon.
# Si l'app est exposée directement sans proxy, mettre TRUST_PROXY=0 (sinon l'IP des visiteurs peut être falsifiée).
# TRUST_PROXY=1

# --- Envoi d'emails (code « mot de passe oublié » de l'admin) ---
# Exemple Gmail : activer la validation en 2 étapes, créer un « mot de passe d'application », puis :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre.adresse@gmail.com
# SMTP_PASS=mot-de-passe-d-application
# MAIL_FROM="CCM-NONSAKA <votre.adresse@gmail.com>"
# Sans SMTP_HOST : en développement le code s'affiche dans la console ; en production aucun email n'est envoyé.

# --- Cache du catalogue (secondes, défaut 600) ---
# Le catalogue public est gardé en mémoire et vidé à CHAQUE écriture faite via l'application (commande, admin). Cette durée n'est qu'un
# filet de sécurité (modification directe en base, plusieurs instances) : longue, elle laisse une base serverless (Neon) s'endormir.
# CATALOG_CACHE_SECONDS=600
