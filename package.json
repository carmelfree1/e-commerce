{
  "name": "ccm-nonsaka",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Boutique en ligne de produits bio CCM-NONSAKA (TypeScript, PostgreSQL, PWA, notifications push)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx scripts/build.ts && tsx watch --env-file-if-exists=.env src/server/index.ts",
    "build": "npm run typecheck && tsx scripts/build.ts --server",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsc -p tsconfig.sw.json",
    "icons": "tsx scripts/make-icons.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "test:security": "node tests/security/attack-1.mjs && node tests/security/attack-2.mjs",
    "start:prod": "node --env-file=.env.production dist/server.js",
    "admin:email": "tsx --env-file-if-exists=.env scripts/admin-email.ts"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/web-push": "^3.6.4",
    "compression": "^1.8.2",
    "esbuild": "^0.25.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "sharp": "^0.35.5"
  }
}
